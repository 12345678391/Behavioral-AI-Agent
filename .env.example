# ============================================================
# Behavioral AI Agent - Environment Configuration Template
# Copy this file to .env (or .env.local) and fill in your keys.
# ============================================================

# Frontend Configuration
REACT_APP_API_BASE_URL=http://localhost:5000/api

# Backend Server Configuration
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000

# LiveKit Cloud Credentials (WebRTC Media & Data Exchange)
# Obtain these from your LiveKit Cloud project settings: https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# AI Models & Audio Providers (Python Agent)
# Obtain from OpenAI platform: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1

# Obtain from Deepgram console: https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key
